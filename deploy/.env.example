# 复制为 .env 并填写真实值。禁止提交 .env。
POSTGRES_USER=srs
POSTGRES_PASSWORD=please_change_me
POSTGRES_DB=srs
SECRET_KEY=please_change_me_to_a_long_random_string
DEMO_PASSWORD=Demo@2026

# AI 助手(OpenAI 兼容; key 留后端, 禁止提交真实 key)
# 默认推荐: 智谱 GLM OpenAI 兼容接口 https://open.bigmodel.cn/api/paas/v4
# 可选本机 Ollama: http://localhost:11434/v1
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=GLM-4.7-Flash

# 地图服务 — 高德地图(推荐默认在线影像, 无 IP 白名单, 换电脑/换网络均可用)
# 申请: https://console.amap.com/  免费配额 30万次/天, 不配置时走无 key 公共通道
GAODE_KEY=

# 地图服务 — 天地图(需固定 IP 白名单, 仅服务器部署时可选; 桌面打包不推荐)
TIANDITU_KEY=
